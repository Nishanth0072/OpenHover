# =============================================================================
# Open-Brain Backend — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# --- Application ---
APP_NAME=Open-Brain
APP_VERSION=1.0.0
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://openbrain:openbrain_secret@localhost:5432/openbrain_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Secrets ---
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# --- AI Provider API Keys (centrally managed) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_API_KEY=your-key-here

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=10

# --- SMTP (OTP Emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_MOCK=false
